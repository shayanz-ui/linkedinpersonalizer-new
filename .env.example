# Copy this file to .env and fill in your key.

# Your Anthropic API key (required). Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Optional: which Claude model to use. Defaults to claude-opus-5.
# For faster / cheaper generation, try claude-haiku-4-5 or claude-sonnet-5.
# MODEL=claude-opus-5

# Optional: port to run the server on. Defaults to 3000.
# PORT=3000

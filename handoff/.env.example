# Copy to .env. Everything is optional: with nothing set, the app runs in demo mode.

# PORT=3100

# Real Google Calendar: path to a service-account key with domain-wide delegation
# (scope https://www.googleapis.com/auth/calendar). Leave unset for the mock calendar.
# GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./service-account.json

# Protect the SDR page with a shared password (username can be anything).
# SDR_ACCESS_KEY=change-me

# Team roster. Defaults to team.json if present, otherwise team.example.json.
# TEAM_FILE=team.json

# How often to check AE calendars for bookings made through their scheduling link.
# WATCH_INTERVAL_SECONDS=60
